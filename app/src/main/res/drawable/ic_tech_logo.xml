    <!-- Central CPU Chip with Lightning -->
    <path
        android:pathData="M35,35 h26 a3,3 0 0 1 3,3 v20 a3,3 0 0 1 -3,3 h-26 a3,3 0 0 1 -3,-3 v-20 a3,3 0 0 1 3,-3 z"
