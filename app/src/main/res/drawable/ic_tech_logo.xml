                android:startX="22"
                android:startY="16"
                android:endX="74"
                android:endY="80"
                android:type="linear">
                <item android:color="#1A00E5FF" android:offset="0.0" />
                <item android:color="#2A8B5CF6" android:offset="1.0" />
            </gradient>
        </aapt:attr>
